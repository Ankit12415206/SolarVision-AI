# Environment variables — copy this to .env and fill in values.
# .env is gitignored; this file IS committed as a template.

# Project root (optional — usually auto-detected via pathlib)
# PROJECT_ROOT=C:/Users/ankit/OneDrive/Desktop/SolarVision-AI

# Logging level override (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Streamlit dashboard settings
STREAMLIT_PORT=8501
STREAMLIT_THEME=light

# Optional: Roboflow API key (for dataset download in Step 2)
ROBOFLOW_API_KEY=your_key_here

# Optional: Kaggle API credentials (for dataset download in Step 2)
KAGGLE_USERNAME=your_username_here
KAGGLE_KEY=your_key_here
